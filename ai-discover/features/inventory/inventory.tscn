[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://features/inventory/inventory.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/back_button.tscn" id="2_back"]

[node name="Inventory" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="Center"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="TitleLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "🎒 背包拖拽"
horizontal_alignment = 1

[node name="Frame" type="PanelContainer" parent="Center/VBox"]
layout_mode = 2

[node name="Grid" type="GridContainer" parent="Center/VBox/Frame"]
layout_mode = 2
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 8
columns = 5

[node name="StatusLabel" type="Label" parent="Center/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "按住物品拖到其他格子 → 交换位置"
horizontal_alignment = 1

[node name="BackButton" parent="." instance=ExtResource("2_back")]
