  "attributes": [
    {
      "id": "attr_001",
      "name_zh": "专精",
      "name_en": "Expertise",
      "element": "metal",
      "governs": ["近战闪避 (Melee Evasion)", "建筑成本与时间降低 (Construction Cost/Time Reduction, as administrator)", "工业收入 (Industry Income)"],
      "description": "金系属性，武将的熟练度与技艺。战斗中提供近战闪避加成，战场定位为扛线防御；作为郡国管理者时降低建筑成本与时间并提高工业产值，是最好的城市建造者。高专精者如赵云、徐晃。金克木、土生金，因此金系技能树中木、火技能各只有1个，土、水技能各有2个。"
    },
    {
      "id": "attr_002",
      "name_zh": "毅力",
      "name_en": "Resolve",
      "element": "wood",
      "governs": ["武将生命值 (General's Health)", "人口增长 (Population Growth, as administrator)", "粮食产出 (Food Production)"],
      "description": "木系属性，武将的意志与勇气。战斗中增加武将本体生命值（每100点约+40%血量），是单挑与混战续航的关键；作为郡国管理者时提高人口增长。木系战士以血厚著称（如关羽、张飞、典韦、许褚）。"
    },
    {
      "id": "attr_003",
      "name_zh": "智略",
      "name_en": "Cunning",
      "element": "water",
      "governs": ["弹药量 (Ammunition, own retinues)", "军队补给 (Military Supplies, own army)", "远程攻速/穿甲/伤害 (Ranged Attack Rate, AP Damage)", "商业贸易 (Commerce & Trade, assignments)"],
      "description": "水系属性，武将的智慧与才智。战斗中提高本方部曲弹药携带量、远程攻速、远程穿甲与伤害（配合火箭/火矢效果更佳），战役中提高军队补给并擅长商业贸易。军师的关键属性，也是间谍任务的最佳人选（如诸葛亮、司马懿、周瑜）。"
    },
    {
      "id": "attr_004",
      "name_zh": "本能",
      "name_en": "Instinct",
      "element": "fire",
      "governs": ["近战杀伤 (Melee Damage)", "征募时间缩短/费用降低 (Recruitment Time & Cost, own army)", "冲锋加成 (Charge Bonus)"],
      "description": "火系属性，武将的胆识与魄力，侵略如火。战斗中大幅提高近战伤害与冲锋威力，能迅速撕裂敌阵、屠杀普通士兵；战役中缩短征募时间并降低招募成本。先锋的关键属性（如吕布、张飞、马腾、公孙瓒、郑姜）。"
    },
    {
      "id": "attr_005",
      "name_zh": "权威",
      "name_en": "Authority",
      "element": "earth",
      "governs": ["满意度 (Satisfaction, only when Faction Leader/Heir/Prime Minister)", "部队士气 (Unit Morale, own retinues)", "公共秩序 (Public Order)", "收入/税收 (Income & Tax, campaign)"],
      "description": "土系属性，武将的威仪与风骨，代表君主气度。战斗中提高本方部曲士气并抵消惊吓；战役中提高公共秩序、收入与税收。只有丞相、储君或派系领袖的权威值会加成全派系满意度，因此高权威者是君主/储君/丞相的理想人选（如曹操、孙坚、袁绍）。"
    }
  ],
  "character_classes": [
    {
      "id": "class_001",
      "name_zh": "战士",
      "name_en": "Champion",
      "element": "wood",
      "role": "单挑专家 (Duelist) / 近战肉盾",
      "specializations": ["长柄/矛步兵部曲 (Polearm & Spear Infantry)", "单挑决斗 (Duels)", "高血量 (Large Health Pool)", "粮食产出与人口增长 (Food & Population)"],
      "description": "木系战士，最善对抗敌军将领，是游戏中最强的单挑者。关键属性【毅力】提高生命值并增加所管理郡国人口。可招募强化持矛步兵，血厚耐打、还有两个伤害技能（聚怒、断筋），属于又肉又能输出的类型；缺点是对普通部队清剿效率不如先锋。代表人物：关羽、张飞、典韦、许褚、太史慈。"
    },
    {
      "id": "class_002",
      "name_zh": "先锋",
      "name_en": "Vanguard",
      "element": "fire",
      "role": "清兵机器 (Unit Killer) / 突击骑兵统帅",
      "specializations": ["突击骑兵部曲 (Shock Cavalry)", "范围AOE伤害 (Splash/AoE Damage)", "近战杀伤 (Melee Damage)", "征募时间缩短/成本降低 (Recruitment Time & Cost)", "士气打击 (Morale Debuffs)"],
      "description": "火系先锋，侵略如火，擅长冲锋近战与指挥突击骑兵，高冲锋加成与范围AOE技能（炎凤、虎啸）使其成为普通士兵的屠戮者。关键属性【本能】提高近战杀伤并降低征募成本。代表人物：吕布、张飞、孙策、马腾、公孙瓒、郑姜。"
    },
    {
      "id": "class_003",
      "name_zh": "卫士",
      "name_en": "Sentinel",
      "element": "metal",
      "role": "前线坦克 (Frontline Tank) / 战略要点守卫",
      "specializations": ["剑/斧与盾牌步兵部曲 (Sword & Shielded Infantry)", "近战闪避 (Melee Evasion)", "远程格挡 (Ranged Block)", "建筑成本/时间降低 (Construction Discount, as administrator)", "工业收入 (Industry Income)"],
      "description": "金系卫士（旧译：铁卫），最善封锁敌军将领或坚守战略要点。拥有极高的近战闪避与远程格挡，是完美的扛线坦克，同时是最佳的城市建设者（降低建筑费用、提高工业收入）。关键属性【专精】。代表技能：不屈、固守、刚韧。代表人物：赵云、徐晃、魏延、典韦（部分版本）。"
    },
    {
      "id": "class_004",
      "name_zh": "指挥",
      "name_en": "Commander",
      "element": "earth",
      "role": "激励者/指挥官 (Inspirer) / 领袖与辅臣",
      "specializations": ["剑骑兵部曲 (Sword Cavalry)", "部队士气光环 (Morale Buffs)", "收入/税收/贸易 (Income, Tax & Trade)", "满意度加成 (Satisfaction)", "高级阵型 (Advanced Formations)", "公共秩序 (Public Order)"],
      "description": "土系指挥，经典的全面战争将军类型，善于激励友军、为全军提供士气加成，其阵亡会对士气造成巨大打击。关键属性【权威】提升部队士气与满意度。战役中提高收入、税收与贸易，是君主、储君、丞相的理想人选。可召唤大盾兵，是优秀的坦克与领袖（如曹操、孙坚、袁绍、刘备、曹仁）。"
    },
    {
      "id": "class_005",
      "name_zh": "军师",
      "name_en": "Strategist",
      "element": "water",
      "role": "战术家 (Tactician) / 远程与攻城支援",
      "specializations": ["弓箭手/弩手部曲 (Archers & Crossbowmen)", "攻城器械 (Siege Weapons, e.g. trebuchets)", "弹药量 (Ammunition)", "军队补给 (Military Supplies)", "全军高级阵型 (Advanced Formations for whole army)", "削弱敌方将领 (Debuff Enemy Generals)"],
      "description": "水系军师，近战能力弱但为军队提供关键远程火力与攻城支援。关键属性【智略】提高弹药量与军队补给，可招募强化远程部曲、解锁投石车等攻城器械，高阶后为全军解锁高级阵型。军师不能进行单挑，应避免进入肉搏。代表人物：诸葛亮、司马懿、周瑜、庞统、郭嘉。"
    }
